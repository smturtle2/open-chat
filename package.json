{
  "name": "openchat",
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "client"
  ],
  "scripts": {
    "start": "node --import=tsx src/index.ts",
    "build": "npm --workspace client run build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p client/tsconfig.json",
    "test": "node tests/run.mjs",
    "test:unit": "node tests/run.mjs",
    "test:e2e": "node tests/run.mjs test_ui.js test_ui_interactions.js"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "better-sqlite3": "^11.8.1",
    "dotenv": "^16.4.7",
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.2",
    "esbuild": "^0.28.2",
    "playwright": "^1.62.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
