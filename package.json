{
  "name": "openchat",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "node --import=tsx src/index.ts",
    "build": "cd client && npm run build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npx tsx tests/test_context.ts && node tests/test_step_sheet.js && node tests/test_working_indicator.js",
    "test:unit": "npx tsx tests/test_context.ts",
    "test:e2e": "node tests/test_step_sheet.js && node tests/test_working_indicator.js"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "better-sqlite3": "^11.8.1",
    "dotenv": "^16.4.7",
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.2",
    "playwright": "^1.62.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
